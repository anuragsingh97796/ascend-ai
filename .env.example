# ==========================================
# Ascend AI - Environment Variables Template
# ==========================================
# WARNING: Do NOT put real secrets in this file.
# Copy this file to .env and fill in your values.

# --------------------------
# Backend (Spring Boot)
# --------------------------
# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/ascendai_db

# JWT Secret (Must be at least 256 bits / 32 characters)
JWT_SECRET=your_super_secret_jwt_key_here_for_local_dev

# Allowed CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# OpenAI API Key (For Spring AI Integration)
OPENAI_API_KEY=sk-your-openai-api-key

# --------------------------
# Frontend (Next.js)
# --------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api

# --------------------------
# Mobile (Expo / React Native)
# --------------------------
EXPO_PUBLIC_API_URL=http://localhost:8080/api
